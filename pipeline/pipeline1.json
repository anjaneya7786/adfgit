{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "lkp_LOAD_CONFIG",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "sql_database",
						"type": "DatasetReference",
						"parameters": {
							"table_nm": "load_config"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "looping_over_files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lkp_LOAD_CONFIG",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lkp_LOAD_CONFIG').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "COPY_DATA_FILE_TO_TABLE",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Lookup1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().source_path}//@{item().file_nm}"
								},
								{
									"name": "Destination",
									"value": "dbo.@{item().table_nm}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"modifiedDatetimeStart": {
											"value": "@activity('Lookup1').output.value[0].last_loaded_dttm",
											"type": "Expression"
										},
										"modifiedDatetimeEnd": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "SqlServerSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "input_dataset",
									"type": "DatasetReference",
									"parameters": {
										"file_name": {
											"value": "@item().file_nm",
											"type": "Expression"
										},
										"file_path": {
											"value": "@item().source_path",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "sql_database",
									"type": "DatasetReference",
									"parameters": {
										"table_nm": {
											"value": "@item().table_nm",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Lookup1",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "SELECT\n    CASE\n        WHEN MAX(loaded_dttm) IS NULL\n        THEN CAST('1900-01-01 00:00:00' AS DATETIME)\n        ELSE MAX(loaded_dttm)\n    END AS last_loaded_dttm \nfrom dbo.load_summary\nwhere file_name='@{item().table_nm}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "sql_database",
									"type": "DatasetReference",
									"parameters": {
										"table_nm": "''"
									}
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "Script1",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "COPY_DATA_FILE_TO_TABLE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "SqlServer1",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'INSERT INTO dbo.load_summary (file_name, loaded_dttm, load_status) VALUES (''',\n  item().table_nm,\n  ''',''',\n  utcNow(),\n  ''',''Success'')'\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}